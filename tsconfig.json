{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "moduleResolution": "node",

    "lib": ["ES2020"],
    "types": ["node"],

    "ignoreDeprecations": "6.0",

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false
  },

  "include": ["src/**/*"],
  "exclude": ["node_modules","dist"]
}